{
  "name": "katha-ekaadeshko",
  "version": "1.0.0",
  "description": "कथा एकादेशको — AI Story Studio (web)",
  "author": "Tryst BJ",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "dev": "vite",
    "dev:vercel": "vercel dev --listen 4173",
    "web:dev": "vite",
    "web:build": "vite build",
    "build": "npm run web:build",
    "verify": "npm run typecheck && npm run lint && npm run build && node scripts/assert-production-bundle.mjs",
    "desktop:dev": "cd desktop/src-tauri && cargo tauri dev",
    "desktop:build": "cd desktop/src-tauri && cargo tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0 && node scripts/i18n-audit.mjs",
    "wallpaper:upscale": "python scripts/upscale-wallpaper.py",
    "narrators:portraits": "node scripts/generate-narrator-portrait-pngs.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "framer-motion": "^12.38.0",
    "i18next": "^24.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.4.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.0",
    "vercel": "^46.0.0",
    "vite": "^5.4.11"
  }
}
