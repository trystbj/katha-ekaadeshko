# Vercel / local dev (vercel env pull -> .env.local)
#
# SECURITY: Never commit real keys. Server-only secrets (OPENAI_*, WORKER_TOKEN,
# SUPABASE_SERVICE_ROLE_KEY) belong in Vercel Environment Variables only — never
# VITE_* except the Supabase anon key. Do not log env values in production.

# Supabase (required for login + cloud projects)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only (render worker + admin APIs on Vercel)
SUPABASE_SERVICE_ROLE_KEY=
WORKER_TOKEN=

# Exposed to the browser (Supabase anon key is safe to expose)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Local `npm run web:dev` (Vite): forward /api to your deployed app so /api/health works (Settings → AI mode: Online)
# KATHA_DEV_API_PROXY=https://your-app.vercel.app

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
LEONARDO_API_KEY=

# Optional: Leonardo model settings
LEONARDO_MODEL_ID=
LEONARDO_MODEL_NAME=
LEONARDO_ALCHEMY=0

# Worker (local PC; not on Vercel)
# APP_BASE_URL=https://your-app.vercel.app
# WORKER_TOKEN=shared-secret-matching-Vercel
# WORKER_VERBOSE=1
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
